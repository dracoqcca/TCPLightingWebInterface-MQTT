# TCP Lighting Bridge
BRIDGE_IP=192.168.1.100
BRIDGE_PORT=443
TCP_TOKEN=your_token_here
LOCAL_URL=http://lighting.local
EXTERNAL_API_PASSWORD=P@ssW0rd

# MQTT Broker Connection
MQTT_BROKER=192.168.1.100
MQTT_PORT=1883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password

# MQTT Topics
MQTT_CLIENT_ID=tcp-bridge
MQTT_PREFIX=light
MQTT_CONTROL=tcp

# Home Assistant Discovery
ENABLE_HA_DISCOVERY=1
HASS_TOPIC_ID=homeassistant
HASS_ONLINE_TOPIC=hass/status

# API
API_BASE_URL=http://TCPLightingWebInterface
POLL_INTERVAL=5
